proc ModulesHelp { } {
    puts stdout "
Description
===========
Canu is a fork of the Celera Assembler, designed for high-noise single-molecule sequencing (such as the PacBio RS II/Sequel or Oxford Nanopore MinION).

More information
================
- BioContainers: https://biocontainers.pro/tools/canu
- Home page:     https://canu.readthedocs.io/en/latest/
"
}

module-whatis "Name:        canu"
module-whatis "Version:     2.3"
module-whatis "Description: Canu is a fork of the Celera Assembler, designed for high-noise single-molecule sequencing (such as the PacBio RS II/Sequel or Oxford Nanopore MinION)."
module-whatis "BioContainers: https://biocontainers.pro/tools/canu"
module-whatis "Home page:   https://canu.readthedocs.io/en/latest/"

#-- Set some internal variables
set     image   "quay.io_biocontainers_canu:2.3--h3fb4750_0.sif"
set     uri     "docker://quay.io/biocontainers/canu:2.3--h3fb4750_0"
set     version "2.3"
set     modroot "/usr/local/usrapps/brc/brc_modules/tools/canu/2.3"

#-- Conflict with any other version of this module
conflict "canu"

#-- Add the application's bin directory to the PATH
prepend-path    PATH    "${modroot}/bin"

#-- Optional bind path (set BIND_PATH in your profile to enable)
source "/usr/local/usrapps/brc/env/modules.config"

#-- Container runtime dependency (omitted on sites where the runtime
#-- is a system binary with no corresponding module entry).
if { [info commands depends-on] ne "" } { depends-on singularity } else { if { ![is-loaded singularity] } { module load singularity } }

#-- Log module load (shared hook: edit /usr/local/usrapps/brc/env/module_log.tcl)
source "/usr/local/usrapps/brc/env/module_log.tcl"
