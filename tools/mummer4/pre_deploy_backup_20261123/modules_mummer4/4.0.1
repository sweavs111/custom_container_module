proc ModulesHelp { } {
    puts stdout "
Description
===========
Mummer4 is a versatile alignment tool for DNA and protein sequences.

More information
================
- BioContainers: https://biocontainers.pro/tools/mummer4
- Home page:     https://github.com/mummer4/mummer
"
}

module-whatis "Name:        mummer4"
module-whatis "Version:     4.0.1"
module-whatis "Description: Mummer4 is a versatile alignment tool for DNA and protein sequences."
module-whatis "BioContainers: https://biocontainers.pro/tools/mummer4"
module-whatis "Home page:   https://github.com/mummer4/mummer"

#-- Set some internal variables
set     image   "quay.io_biocontainers_mummer4:4.0.1--pl5321h9948957_0.sif"
set     uri     "docker://quay.io/biocontainers/mummer4:4.0.1--pl5321h9948957_0"
set     version "4.0.1"
set     modroot "/usr/local/usrapps/brc/brc_modules/tools/mummer4/4.0.1"

#-- Conflict with any other version of this module
conflict "mummer4"

#-- Add the application's bin directory to the PATH
prepend-path    PATH    "${modroot}/bin"

#-- Optional bind path (set BIND_PATH in your profile to enable)
source "/usr/local/usrapps/brc/env/modules.config"

#-- Container runtime dependency (omitted on sites where the runtime
#-- is a system binary with no corresponding module entry).
if { [info commands depends-on] ne "" } { depends-on singularity } else { if { ![is-loaded singularity] } { module load singularity } }

#-- Log module load (shared hook: edit /usr/local/usrapps/brc/env/module_log.tcl)
source "/usr/local/usrapps/brc/env/module_log.tcl"
