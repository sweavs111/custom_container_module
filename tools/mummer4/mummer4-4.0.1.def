Bootstrap: docker
From: condaforge/miniforge3:24.3.0-0

%labels
    Maintainer sdweave2@ncsu.edu
    Source https://github.com/mummer4/mummer
    Version 4.0.1

%help
    MUMmer4: whole-genome alignment (nucmer, promer, mummer) plus
    delta/coords utilities and dotplots (mummerplot).

    Why this image exists: the stock biocontainer
    (quay.io/biocontainers/mummer4:4.0.1--pl5321h9948957_0) ships
    mummerplot but none of MUMmer's optional plotting utilities, so
    mummerplot dies looking for gnuplot. This image installs the exact same
    conda package set as the stock image (every package pinned to its version
    and build string) and adds gnuplot, fig2dev and xfig from apt.

    Usage (no single entry point; the runscript runs nucmer):
        apptainer run  mummer4-4.0.1.sif ref.fa qry.fa -p out    # nucmer
        apptainer exec mummer4-4.0.1.sif <program> [options]

    Programs: nucmer, promer, mummer, delta-filter, show-coords, show-snps,
    show-aligns, show-tiling, dnadiff, mummerplot, mapview, repeat-match,
    exact-tandems, combineMUMs, annotate, dna2aa

    Plotting utilities (MUMmer's optional deps, Ubuntu 20.04 apt builds):
        gnuplot (gnuplot-x11; png/postscript/x11 terminals), fig2dev, xfig
        mummerplot --png / --postscript work headless; the interactive x11
        terminal and xfig need X11 forwarding (ssh -X).

    Example:
        apptainer exec mummer4-4.0.1.sif nucmer -t 8 ref.fa qry.fa -p out
        apptainer exec mummer4-4.0.1.sif mummerplot --png --layout -p plot out.delta

%post -c /bin/bash
    set -e
    export DEBIAN_FRONTEND=noninteractive

    # Hazel bind-mount points
    mkdir -p /rs1 /share /home /usr/local/usrapps

    # MUMmer's optional plotting utilities (README minimums: gnuplot 4.0,
    # fig2dev 3.2.3, xfig 3.2). Installed from apt, not conda: fig2dev and
    # xfig aren't on conda-forge, and keeping gnuplot out of the conda solve
    # leaves the exact-pinned package set below untouched. mummerplot finds
    # gnuplot on PATH (/usr/bin). gnuplot-x11 = png/postscript + x11
    # terminals, without pulling in Qt.
    apt-get update
    apt-get install -y --no-install-recommends gnuplot-x11 fig2dev xfig
    rm -rf /var/lib/apt/lists/*

    # Pattern 4 (bioconda via miniforge3 + mamba). No GPU deps.
    # Every package pinned to the exact version=build of the stock
    # biocontainer (from its /usr/local/conda-meta, conda 24.5.0 install of
    # 2025-02-04), so the only intended difference is the plotting tools.
    mamba create -n mummer4 -y --strict-channel-priority -c conda-forge -c bioconda \
        "mummer4=4.0.1=pl5321h9948957_0" \
        "yaggo=1.5.10=hdfd78af_1" \
        "perl=5.32.1=7_hd590300_perl5" \
        "ruby=3.4.1=he7af4c9_0" \
        "_libgcc_mutex=0.1=conda_forge" \
        "_openmp_mutex=4.5=2_gnu" \
        "ca-certificates=2025.1.31=hbcca054_0" \
        "gdbm=1.18=h0a1914f_2" \
        "gmp=6.3.0=hac33072_2" \
        "libffi=3.4.2=h7f98852_5" \
        "libgcc=14.2.0=h77fa898_1" \
        "libgcc-ng=14.2.0=h69a702a_1" \
        "libgomp=14.2.0=h77fa898_1" \
        "libstdcxx=14.2.0=hc0a3c3a_1" \
        "libstdcxx-ng=14.2.0=h4852527_1" \
        "libxcrypt=4.4.36=hd590300_1" \
        "libzlib=1.3.1=hb9d3cd8_2" \
        "ncurses=6.5=h2d0b736_3" \
        "openssl=3.4.0=h7b32b05_1" \
        "readline=8.2=h8228510_1" \
        "yaml=0.2.5=h7f98852_2"
    mamba clean -afy

%environment
    export DEBIAN_FRONTEND=noninteractive
    export PATH="/opt/conda/envs/mummer4/bin:$PATH"

%runscript
    exec nucmer "$@"

%test
    set -e
    # %environment is not sourced for %test — set PATH here.
    export PATH="/opt/conda/envs/mummer4/bin:$PATH"
    nucmer --version
    for prog in nucmer promer mummer delta-filter show-coords show-snps dnadiff mummerplot gnuplot fig2dev xfig; do
        command -v "$prog" || { echo "ERROR: $prog not on PATH" >&2; exit 1; }
    done
    gnuplot --version
    fig2dev -V
