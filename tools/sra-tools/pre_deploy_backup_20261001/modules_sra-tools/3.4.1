proc ModulesHelp { } {
    puts stdout "
Description
===========
The SRA Toolkit and SDK from NCBI is a collection of tools and libraries for using data in the INSDC Sequence Read Archives.

More information
================
- BioContainers: https://biocontainers.pro/tools/sra-tools
- Home page:     https://github.com/ncbi/sra-tools
"
}

module-whatis "Name:        sra-tools"
module-whatis "Version:     3.4.1"
module-whatis "Description: The SRA Toolkit and SDK from NCBI is a collection of tools and libraries for using data in the INSDC Sequence Read Archives."
module-whatis "BioContainers: https://biocontainers.pro/tools/sra-tools"
module-whatis "Home page:   https://github.com/ncbi/sra-tools"

#-- Set some internal variables
set     image   "quay.io_biocontainers_sra-tools:3.4.1--2_linux_64.sif"
set     uri     "docker://quay.io/biocontainers/sra-tools:3.4.1--2_linux_64"
set     version "3.4.1"
set     modroot "/usr/local/usrapps/brc/brc_modules/tools/sra-tools/3.4.1"

#-- Conflict with any other version of this module
conflict "sra-tools"

#-- Add the application's bin directory to the PATH
prepend-path    PATH    "${modroot}/bin"

#-- Optional bind path (set BIND_PATH in your profile to enable)
source "/usr/local/usrapps/brc/brc_modules/env/modules.config"

#-- This image ships NCBI's prebuilt binaries, which look for CA certs only in
#-- system paths (/etc/ssl, /etc/pki) that don't exist in the container. Bind
#-- the host's RHEL CA bundle in (at the same path, which the binaries search;
#-- avoid src:dst syntax, Modules mangles ":" in --delim=, paths) so HTTPS to
#-- NCBI (locate.ncbi.nlm.nih.gov) verifies.
prepend-path --delim=, APPTAINER_BINDPATH "/etc/pki/ca-trust/extracted/pem/tls-ca-bundle.pem"

#-- Container runtime dependency (omitted on sites where the runtime
#-- is a system binary with no corresponding module entry).
if { [info commands depends-on] ne "" } { depends-on singularity } else { if { ![is-loaded singularity] } { module load singularity } }

#-- Log module load
if { [module-info mode load] } {
    catch {
        set _ts    [clock format [clock seconds] -format {%Y-%m-%dT%H:%M:%S%z} -timezone :America/New_York]
        set _ts    [regsub {(\d\d)$} $_ts {:\1}]
        set _user  $env(USER)
        set _group $env(GROUP)
        set _parts [lrange [split [module-info name] /] end-1 end]
        set _tool  [lindex $_parts 0]
        set _ver   [lindex $_parts 1]
        set _fh    [open "/usr/local/usrapps/brc/brc_modules/logs/module_loads.log" a]
        puts $_fh  "${_ts}|${_user}|${_group}|${_tool}|${_ver}"
        close $_fh
    }
}
