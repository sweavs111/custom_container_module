proc ModulesHelp { } {
    puts stdout "
Description
===========
BEAST 2 is a cross-platform program for Bayesian phylogenetic analysis of molecular sequences.

More information
================
- BioContainers: https://biocontainers.pro/tools/beast2
- Home page:     https://www.beast2.org
"
}

module-whatis "Name:        beast2"
module-whatis "Version:     2.7.7"
module-whatis "Description: BEAST 2 is a cross-platform program for Bayesian phylogenetic analysis of molecular sequences."
module-whatis "BioContainers: https://biocontainers.pro/tools/beast2"
module-whatis "Home page:   https://www.beast2.org"

#-- Set some internal variables
set     image   "quay.io_biocontainers_beast2:2.7.7--he65b2d3_0.sif"
set     uri     "docker://quay.io/biocontainers/beast2:2.7.7--he65b2d3_0"
set     version "2.7.7"
set     modroot "/usr/local/usrapps/brc/brc_modules/tools/beast2/2.7.7"

#-- Conflict with any other version of this module
conflict "beast2"

#-- Add the application's bin directory to the PATH
prepend-path    PATH    "${modroot}/bin"

#-- Optional bind path (set BIND_PATH in your profile to enable)
source "/usr/local/usrapps/brc/brc_modules/modules.config"

#-- Container runtime dependency (omitted on sites where the runtime
#-- is a system binary with no corresponding module entry).
if { [info commands depends-on] ne "" } { depends-on singularity } else { if { ![is-loaded singularity] } { module load singularity } }

#-- Log module load
if { [module-info mode load] } {
    catch {
        set _ts    [clock format [clock seconds] -format {%Y-%m-%dT%H:%M:%SZ} -gmt 1]
        set _user  $env(USER)
        set _group $env(GROUP)
        set _parts [split [module-info name] /]
        set _tool  [lindex $_parts 0]
        set _ver   [lindex $_parts 1]
        set _fh    [open "/usr/local/usrapps/brc/brc_modules/logs/module_loads.log" a]
        puts $_fh  "${_ts}|${_user}|${_group}|${_tool}|${_ver}"
        close $_fh
    }
}
