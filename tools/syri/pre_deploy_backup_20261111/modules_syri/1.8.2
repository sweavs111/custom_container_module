proc ModulesHelp { } {
    puts stdout "
Description
===========
Syri compares alignments between two chromosome-level assemblies and identifies synteny and structural rearrangements.

More information
================
- BioContainers: https://biocontainers.pro/tools/syri
- Home page:     https://github.com/schneebergerlab/syri
"
}

module-whatis "Name:        syri"
module-whatis "Version:     1.8.2"
module-whatis "Description: Syri compares alignments between two chromosome-level assemblies and identifies synteny and structural rearrangements."
module-whatis "BioContainers: https://biocontainers.pro/tools/syri"
module-whatis "Home page:   https://github.com/schneebergerlab/syri"

#-- Set some internal variables
set     image   "quay.io_biocontainers_syri:1.8.2--py310h0c14f88_0.sif"
set     uri     "docker://quay.io/biocontainers/syri:1.8.2--py310h0c14f88_0"
set     version "1.8.2"
set     modroot "/usr/local/usrapps/brc/brc_modules/tools/syri/1.8.2"

#-- Conflict with any other version of this module
conflict "syri"

#-- Add the application's bin directory to the PATH
prepend-path    PATH    "${modroot}/bin"

#-- Optional bind path (set BIND_PATH or BIND_CONFIG_FILE in your profile to enable)
source "/usr/local/usrapps/brc/env/modules.config"

#-- Container runtime dependency (omitted on sites where the runtime
#-- is a system binary with no corresponding module entry).
if { [info commands depends-on] ne "" } { depends-on singularity } else { if { ![is-loaded singularity] } { module load singularity } }

#-- Log module load (shared hook: edit /usr/local/usrapps/brc/env/module_log.tcl)
source "/usr/local/usrapps/brc/env/module_log.tcl"
